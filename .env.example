# Writing model. Claude is used whenever this is set.
ANTHROPIC_API_KEY=
# Optional: model, input size (characters of page notes per call) and output limit.
# LLM_MODEL=claude-opus-5-5
# LLM_INPUT_CHARS=120000
# LLM_MAX_OUTPUT=16000

# Testing only, when ANTHROPIC_API_KEY is empty: any OpenAI-compatible endpoint.
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

# Web search for competitors needs no key (DuckDuckGo, then Bing). A paid provider such as DataForSEO can be
# added in server/search.ts later for search volumes and keyword data.

# Database. Leave empty to use the built-in local database in .data/ (nothing to install).
# For Supabase or any Postgres, paste its connection string (Supabase: Connect > Session pooler).
# DATABASE_URL=postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
